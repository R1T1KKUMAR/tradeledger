rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user owns exactly their own ledger.
    // users/{uid}/entries/{date} — no one else can read or write it.
    match /users/{uid}/entries/{date} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Nothing else is readable or writable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
